/ {
    leds {
        extled: ext_led {
            gpios = < &gpio0 0x4 0x0 >;
            label = "External User RED LED";
        };
    };
    aliases {
        external-led = &extled;
        app-led = &led0;
    };

    obled_driver0: obled_driver {
        compatible = "obled,driver";
        status = "okay";
    };
};
